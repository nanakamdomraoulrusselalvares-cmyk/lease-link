# Supabase Configuration
# Replace with your actual Project URL and Anon Key from Supabase Dashboard (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Optional: for administrative operations and instant user auto-confirm)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Verification (Resend)
# Sign up at https://resend.com to get your API key (Free tier: 3,000 emails/month, 100/day)
# If not provided, LeaseLink runs in Dev Mode and logs the 6-digit OTP code to the server console & displays an instant test badge.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=LeaseLink <onboarding@resend.dev>

# Secret for HMAC-signing OTP tokens (Optional: defaults to a secure internal key if unset)
OTP_SECRET=your-random-32-character-secret
